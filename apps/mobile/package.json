{
  "name": "@gridzy/mobile",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Capacitor shell that packages the Gridzy web game as an Android app.",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "sync": "npm run build --prefix ../web && cap sync android",
    "apk": "npm run sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "sharp": "0.35.5"
  }
}
